wsl --install

Dockerfile:
# 使用官方 ollama 镜像作为基础
FROM ollama/ollama:latest

# 设置环境变量，让 ollama 监听所有网络接口
ENV OLLAMA_HOST=0.0.0.0

# 声明容器运行时监听的端口
EXPOSE 11434

# 容器启动时执行的命令
CMD ["serve"]

docker-compose.yml:
version: '3.8'

services:
  ollama:
    # 使用当前目录的 Dockerfile 来构建镜像
    build: .
    container_name: ollama
    restart: unless-stopped
    ports:
      - "11434:11434"
    volumes:
      # 将容器内的模型文件夹挂载到当前目录，实现数据持久化
      - ./ollama_data:/root/.ollama

